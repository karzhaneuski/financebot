# Telegram bot token from @BotFather
BOT_TOKEN=

# Anthropic API key for Claude Vision
ANTHROPIC_API_KEY=

# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/financebot

# PostgreSQL credentials (used by docker-compose and DATABASE_URL above)
POSTGRES_USER=financebot
POSTGRES_PASSWORD=changeme

# Redis connection string
REDIS_URL=redis://redis:6379/0

# exchangerate-api.com API key (free tier, https://www.exchangerate-api.com)
EXCHANGE_API_KEY=

# Dev mode: token accepted as Bearer <DEV_TOKEN>, resolved to this Telegram user_id
DEV_TOKEN=
DEV_USER_ID=0
