# Production environment for docker-compose.prod.yml. Copy to .env,
# fill in every value, `chmod 600 .env`. Never commit the real file.

# Telegram bot token from @BotFather. Issue a NEW token for the Oracle
# server (/revoke in @BotFather) — the old one was in the repo history.
BOT_TOKEN=

# Anthropic API key (Claude Vision receipt parsing, search parser).
ANTHROPIC_API_KEY=

# exchangerate-api.com API key. RE-ISSUE IT before going live: the old
# key was committed in .env and appeared in logs (it is part of the
# request URL).
EXCHANGE_API_KEY=

# PostgreSQL (the `db` service). Credentials are created on first start of
# an empty volume. Use a long random password (e.g. `openssl rand -hex 32`).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Must match the three values above, host `db`, asyncpg driver:
#   postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
# Write it out literally — ${...} is not expanded by the app.
DATABASE_URL=

# Upstash Redis, TLS URL: rediss://default:<password>@<host>:6379
REDIS_URL=

# Local development only — leave unset in production (docker-compose.prod.yml
# forces DEV_MODE=false and an empty DEV_TOKEN anyway).
#   DEV_MODE=true enables "Authorization: Bearer <DEV_TOKEN>" as DEV_USER_ID.
# DEV_MODE=
# DEV_TOKEN=
# DEV_USER_ID=
